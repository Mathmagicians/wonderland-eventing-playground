# proto-file: hexagon.proto
# proto-message: Story

name: "White Rabbit Story"
base_package: "dk.mathmagicians.playground.confluent.stories.whiterabbit"
port { name: "NoTimeToHaggle"  implements: "Story" }
hears {
  payload: "Offer"
  scenario: "the_white_rabbit_has_no_time_to_haggle.feature:9"
}
publishes {
  payload: "Order"
  through: "PublishMessage"
  scenario: "the_white_rabbit_has_no_time_to_haggle.feature:9"
}
depends_on: "application"
depends_on: "domain"
annotated { type: "package-info"  annotation: "@Module"  value: "White Rabbit Story" }
annotated { type: "NoTimeToHaggle"  annotation: "@PrimaryPort" }
annotated { type: "WhiteRabbitStory"  annotation: "@AutoConfiguration" }
annotated { type: "WhiteRabbitStory"  annotation: "@EnableConfigurationProperties"  value: "WhiteRabbitProperties" }
annotated { type: "WhiteRabbitStory.whiteRabbit"  annotation: "@Bean"  value: "NoTimeToHaggle" }
annotated { type: "WhiteRabbitProperties"  annotation: "@ConfigurationProperties"  value: "white-rabbit" }
