@startuml
' the streams from the model: what each story publishes and subscribes to, a queue per payload
left to right direction

queue "Offer" as q_Offer
queue "Order" as q_Order
queue "Product" as q_Product
queue "Transaction" as q_Transaction
hexagon "Load Story" as s_Load_Story <<story>> {
  label " " as s_Load_Story_in
}
hexagon "Tea Party Story" as s_Tea_Party_Story <<story>> {
  label " " as s_Tea_Party_Story_in
}

s_Load_Story_in --> q_Offer : publishes
s_Load_Story_in --> q_Order : publishes
s_Load_Story_in --> q_Product : publishes
q_Offer --> s_Tea_Party_Story_in : subscribes
q_Order --> s_Tea_Party_Story_in : subscribes
s_Tea_Party_Story_in --> q_Transaction : publishes
@enduml
